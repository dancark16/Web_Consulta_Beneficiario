# ============================================
# CONFIGURACIÓN BASE DE DATOS
# ============================================
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_SERVER=192.168.98.210
DB_SERVER_FALLBACKS=192.168.98.212,192.168.98.213
DB_NAME=tu_base_datos

# ============================================
# CONFIGURACIÓN SERVIDOR
# ============================================
PORT=3000

# ============================================
# CONFIGURACIÓN SEGURIDAD - CORS
# ============================================
# Dominios permitidos (separar con comas, SIN espacios)
# En desarrollo: http://localhost:3000,http://localhost:3001
# En producción: https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.77.107:3000

# ============================================
# NOTAS DE SEGURIDAD
# ============================================
# ⚠️ Cambiar DB_USER y DB_PASSWORD a credenciales seguras
# ⚠️ Limitar ALLOWED_ORIGINS a dominios específicos permitidos
# ⚠️ Rate Limit: 30 solicitudes/IP en 15 minutos (línea 45 en server.js)
# ⚠️ Recomendado: Implementar HTTPS con certificado válido
# ⚠️ Cedulas NO se loguean (removidas de console.log por seguridad)

